---
source: cubesql/src/compile/test/test_cube_join.rs
expression: sql
---
SELECT 
  "kibana"."customer_gender" "customer_gender", "kibana"."has_subscription" "has_subscription", "kibana"."read" "read", "kibana"."content" "content"
  
FROM (
  SELECT 
    "kibana"."customer_gender" "customer_gender", "kibana"."has_subscription" "has_subscription", "logs"."read" "read", "logs"."content" "content"
    
  FROM (
    SELECT * FROM {
      "query": {
        "measures": [],
        "dimensions": [
          "KibanaSampleDataEcommerce.customer_gender",
          "KibanaSampleDataEcommerce.has_subscription"
        ],
        "segments": [],
        "order": [],
        "ungrouped": true
      },
      "meta": {
        "protocol": "postgres",
        "apiType": "sql",
        "appName": "NULL"
      },
      "member_to_alias": {
        "KibanaSampleDataEcommerce.customer_gender": "customer_gender",
        "KibanaSampleDataEcommerce.has_subscription": "has_subscription"
      }
    }
  ) AS "kibana" 
  LEFT JOIN (SELECT * FROM {
    "query": {
      "measures": [],
      "dimensions": [
        "Logs.read",
        "Logs.content"
      ],
      "segments": [],
      "order": [],
      "ungrouped": true
    },
    "meta": {
      "protocol": "postgres",
      "apiType": "sql",
      "appName": "NULL"
    },
    "member_to_alias": {
      "Logs.content": "content",
      "Logs.read": "read"
    }
  }) AS "logs" ON ("kibana"."has_subscription" = "logs"."read")
) AS "kibana" 
LIMIT 50000
