{
  "name": "@cubejs-backend/postgres-driver",
  "description": "Cube.js Postgres database driver",
  "author": "Cube Dev, Inc.",
  "version": "1.7.36",
  "repository": {
    "type": "git",
    "url": "https://github.com/cube-js/cube.git",
    "directory": "packages/cubejs-postgres-driver"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/src",
    "index.js"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && npm run tsc",
    "tsc": "tsc",
    "watch": "tsc -w",
    "integration": "npm run integration:postgres",
    "integration:postgres": "jest --verbose dist/test"
  },
  "dependencies": {
    "@cubejs-backend/base-driver": "1.7.36",
    "@cubejs-backend/shared": "1.7.36",
    "@types/pg": "^8.16.0",
    "@types/pg-query-stream": "^1.0.3",
    "pg": "^8.18.0",
    "pg-query-stream": "^4.1.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@cubejs-backend/linter": "1.7.36",
    "@cubejs-backend/testing-shared": "1.7.36",
    "@types/jest": "^29",
    "@types/node": "^22",
    "testcontainers": "^10.28.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
