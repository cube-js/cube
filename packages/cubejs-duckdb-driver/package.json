{
  "name": "@cubejs-backend/duckdb-driver",
  "description": "Cube DuckDB database driver",
  "author": "Cube Dev, Inc.",
  "version": "1.7.37",
  "repository": {
    "type": "git",
    "url": "https://github.com/cube-js/cube.git",
    "directory": "packages/cubejs-duckdb-driver"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/src",
    "index.js"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && npm run tsc",
    "tsc": "tsc",
    "watch": "tsc -w",
    "unit": "jest --verbose dist/test/unit",
    "integration": "npm run integration:duckdb",
    "integration:duckdb": "jest --verbose dist/test"
  },
  "dependencies": {
    "@cubejs-backend/base-driver": "1.7.37",
    "@cubejs-backend/schema-compiler": "1.7.37",
    "@cubejs-backend/shared": "1.7.37",
    "duckdb": "^1.4.1"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@cubejs-backend/linter": "1.7.37",
    "@cubejs-backend/testing-shared": "1.7.37",
    "@types/jest": "^29",
    "@types/node": "^22",
    "jest": "^29",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
