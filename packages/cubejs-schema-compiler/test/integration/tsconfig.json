{
  "extends": "../../../../tsconfig.base.json",
  "include": ["."],
  "compilerOptions": {
    "types": ["node", "jest"],
    // Same as the package tsconfig, see the antlr4 note there.
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "../../dist/test/integration",
    "rootDir": ".",
