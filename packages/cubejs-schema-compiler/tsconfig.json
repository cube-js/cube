{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test"],
  "compilerOptions": {
    // antlr4 ships `types: index.d.cts` re-exporting `.d.ts` files that are ESM under its own
    // `type: module`, so under node16/nodenext every re-export fails (TS2834) and the module
    // resolves to nothing. `bundler` ignores the CJS/ESM split; `commonjs` keeps the emit.
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "experimentalDecorators": true
  },
  "references": [
    { "path": "../cubejs-backend-native" },
    { "path": "../cubejs-backend-shared" },
    { "path": "../cubejs-mssql-driver" },
    { "path": "../cubejs-query-orchestrator" }
  ]
}
