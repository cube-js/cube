{
  "name": "@cubejs-backend/model-schema",
  "description": "JSON Schema of the Cube model language, generated from Core's validator",
  "author": "Cube Dev, Inc.",
  "version": "1.8.14",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cube-js/cube.git",
    "directory": "packages/cubejs-model-schema"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "index.js",
    "index.json",
    "manifests"
  ],
  "main": "index.js",
  "scripts": {
    "build": "rm -rf dist && npm run tsc && npm run generate",
    "tsc": "tsc",
    "watch": "tsc -w",
    "generate": "node dist/src/generate.js"
  },
  "devDependencies": {
    "@cubejs-backend/linter": "1.8.14",
    "@cubejs-backend/schema-compiler": "1.8.14",
    "@types/node": "^22",
    "typescript": "~6.0.3"
  },
  "license": "Apache-2.0"
}
