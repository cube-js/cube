      "description": "Links rendered on this dimension's cells in supporting tools (e.g. dashboard tables). Each link opens an external url (a SQL expression) or drills into a dashboard referenced by its slug.",
      "items": Object {
        "additionalProperties": false,
        "allOf": Array [
