    "dimension_mask": Object {
      "anyOf": Array [
        Object {
          "$ref": "#/definitions/mask_sql",
        },
        Object {
          "pattern": "^\\\\s*[+-]?(?:(?:\\\\d+(?:\\\\.\\\\d*)?)|(?:\\\\.\\\\d+))(?:[eE][+-]?\\\\d+)?\\\\s*$",
