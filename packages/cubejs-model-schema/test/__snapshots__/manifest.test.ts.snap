            "description": "Label shown to viewers",
            "type": "string",
          },
          "name": Object {
            "description": "Unique link identifier within the dimension",
            "pattern": "^[_a-zA-Z][_a-zA-Z0-9]*$",
            "type": "string",
          },
          "params": Object {
            "description": "Query parameters appended to the link URL; values are SQL expressions",
            "items": Object {
              "additionalProperties": false,
              "properties": Object {
