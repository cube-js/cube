            "type": "boolean",
          },
          "target": Object {
            "description": "Where the link opens",
            "enum": Array [
              "blank",
              "self",
            ],
            "type": "string",
          },
          "url": Object {
            "description": "SQL expression building the external URL (e.g. a member reference like {full_name})",
