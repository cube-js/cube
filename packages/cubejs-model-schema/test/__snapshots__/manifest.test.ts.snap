    "view_cube": Object {
      "additionalProperties": false,
      "allOf": Array [
        Object {
          "anyOf": Array [
            Object {
              "required": Array [
                "join_path",
              ],
            },
            Object {
              "required": Array [
                "joinPath",
              ],
            },
          ],
        },
        Object {
          "not": Object {
            "allOf": Array [
              Object {
                "not": Object {
                  "properties": Object {
                    "split": false,
                  },
                },
              },
              Object {
                "not": Object {
                  "properties": Object {
                    "prefix": false,
                  },
                },
              },
            ],
          },
        },
      ],
      "patternProperties": Object {
        "^joinPath$": Object {
          "allOf": Array [
            Object {
              "$ref": "#/definitions/cube_join_path",
            },
          ],
          "deprecated": true,
        },
      },
      "properties": Object {
        "alias": Object {
          "description": "Override the name of the cube",
          "type": "string",
        },
        "excludes": Object {
          "description": "Members to exclude from the cube",
          "items": Object {
            "type": "string",
          },
          "type": "array",
        },
        "includes": Object {
          "anyOf": Array [
            Object {
              "enum": Array [
                "*",
              ],
              "type": "string",
            },
            Object {
              "items": Object {
                "anyOf": Array [
                  Object {
                    "type": "string",
                  },
                  Object {
                    "additionalProperties": false,
                    "properties": Object {
                      "alias": Object {
                        "description": "Name the member gets in the view",
                        "pattern": "^[_a-zA-Z][_a-zA-Z0-9]*$",
                        "type": "string",
                      },
                      "description": Object {
                        "description": "Override the description of the included member",
                        "type": "string",
                      },
                      "format": Object {
                        "anyOf": Array [
                          Object {
                            "enum": Array [
                              "imageUrl",
                              "link",
                              "currency",
                              "percent",
                              "number",
                              "id",
                            ],
                            "type": "string",
                          },
                          Object {
                            "$ref": "#/definitions/format_type",
                          },
                        ],
                        "description": "Override the display format of the included member",
                      },
                      "meta": Object {
                        "description": "Override the metadata of the included member as a whole",
                      },
                      "name": Object {
                        "description": "Name of the member to include",
                        "pattern": "^[_a-zA-Z][_a-zA-Z0-9]*$",
                        "type": "string",
                      },
                      "title": Object {
                        "description": "Override the display title of the included member",
                        "type": "string",
                      },
                    },
                    "required": Array [
                      "name",
                    ],
                    "type": "object",
                  },
                ],
              },
              "type": "array",
            },
          ],
          "description": "Specify which members to include from the cube. Use '*' for all members, or an array of member names/objects with aliases",
        },
        "join_path": Object {
          "$ref": "#/definitions/cube_join_path",
        },
        "prefix": Object {
          "description": "Whether to prefix the included members with the cube name",
          "pattern": "^([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])$",
          "type": Array [
            "boolean",
            "string",
          ],
        },
        "split": Object {
          "description": "Whether to expose this cube's members in a separate view named <view>_<cube>",
          "pattern": "^([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])$",
          "type": Array [
            "boolean",
            "string",
          ],
        },
      },
      "required": Array [
        "includes",
      ],
