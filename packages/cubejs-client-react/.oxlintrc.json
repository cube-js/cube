// cubejs-client-react's lint config: the shared React rule set plus this package's own
// environment. The rules themselves live in @cubejs-backend/linter/airbnb-react.json so
// cubejs-playground can extend the same set.
{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.json",
    "../cubejs-linter/airbnb-react.json"
  ],
  // env and ignorePatterns are not inherited through `extends`
  "env": {
    "node": true,
    "browser": true,
    "es6": true
  },
  "ignorePatterns": ["dist/", "lib/", "coverage/", "**/*.d.ts"]
}
