exports[`GraphQL Schema printed SDL stays stable 1`] = `
"\\"\\"\\"
A date-time string at UTC, such as 2007-12-03T10:15:30Z, compliant with the \`date-time\` format outlined in section 5.6 of the RFC 3339 profile of the ISO 8601 standard for representation of dates and times using the Gregorian calendar.
\\"\\"\\"
scalar DateTime

input FloatFilter {
  equals: Float
  notEquals: Float
  in: [Float]
  notIn: [Float]
  set: Boolean
  gt: Float
  lt: Float
  gte: Float
  lte: Float
}

input StringFilter {
  equals: String
  notEquals: String
  in: [String]
  notIn: [String]
  contains: [String]
  notContains: [String]
  startsWith: [String]
  notStartsWith: [String]
  endsWith: [String]
  notEndsWith: [String]
  set: Boolean
}

input DateTimeFilter {
  equals: [String]
  notEquals: [String]
  in: [String]
  notIn: [String]
  inDateRange: [String]
  notInDateRange: [String]
  beforeDate: String
  beforeOrOnDate: String
  afterDate: String
  afterOrOnDate: String
  set: Boolean
}

enum OrderBy {
  asc
  desc
}

type TimeDimension {
  value: DateTime!
  second: DateTime!
  minute: DateTime!
  hour: DateTime!
  day: DateTime!
  week: DateTime!
  month: DateTime!
  quarter: DateTime!
  year: DateTime!
}

type OrdersMembers {
  count: String
  totalAmount: String
  id: String
  status: String
  createdAt: TimeDimension
}

input OrdersWhereInput {
  AND: [OrdersWhereInput!]
  OR: [OrdersWhereInput!]
  count: StringFilter
  totalAmount: StringFilter
  id: StringFilter
  status: StringFilter
  createdAt: DateTimeFilter
}

input OrdersOrderByInput {
  count: OrderBy
  totalAmount: OrderBy
  id: OrderBy
  status: OrderBy
  createdAt: OrderBy
}

type UsersMembers {
  count: String
  id: String
  city: String
  createdAt: TimeDimension
}

input UsersWhereInput {
  AND: [UsersWhereInput!]
  OR: [UsersWhereInput!]
  count: StringFilter
  id: StringFilter
  city: StringFilter
  createdAt: DateTimeFilter
}

input UsersOrderByInput {
  count: OrderBy
  id: OrderBy
  city: OrderBy
  createdAt: OrderBy
}

input RootWhereInput {
  AND: [RootWhereInput!]
  OR: [RootWhereInput!]
  orders: OrdersWhereInput
  users: UsersWhereInput
}

input RootOrderByInput {
  orders: OrdersOrderByInput
  users: UsersOrderByInput
}

type Result {
  orders(where: OrdersWhereInput, orderBy: OrdersOrderByInput): OrdersMembers!
  users(where: UsersWhereInput, orderBy: UsersOrderByInput): UsersMembers!
}

type Query {
  cube(where: RootWhereInput, limit: Int, offset: Int, timezone: String, cache: String, ungrouped: Boolean, orderBy: RootOrderByInput): [Result!]!
}
"
`;

