{
  "name": "@cubejs-backend/snowflake-driver",
  "description": "Cube Snowflake database driver",
  "author": "Cube Dev, Inc.",
  "version": "1.7.37",
  "repository": {
    "type": "git",
    "url": "https://github.com/cube-js/cube.git",
    "directory": "packages/cubejs-snowflake-driver"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/src",
    "index.js"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && npm run tsc",
    "tsc": "tsc",
    "watch": "tsc -w",
    "unit": "vitest run test/unit",
    "integration": "npm run integration:snowflake",
    "integration:snowflake": "vitest run test/SnowflakeDriver.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.0",
    "@cubejs-backend/base-driver": "1.7.37",
    "@cubejs-backend/shared": "1.7.37",
    "snowflake-sdk": "^2.4.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cubejs-backend/linter": "1.7.37",
    "@types/node": "^22",
    "typescript": "~6.0.3",
    "vitest": "^4"
  }
}
